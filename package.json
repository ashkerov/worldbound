{
  "name": "worldbound",
  "version": "0.0.1",
  "private": true,
  "description": "WORLDBOUND — симулятор живого мира",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.sim.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint src tools tests prototypes",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "diorama": "vite --open /prototypes/diorama/index.html",
    "test:headed": "playwright test --config playwright.headed.config.ts",
    "bench": "playwright test --config playwright.bench.config.ts",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "check:assets": "node tools/check-assets.mjs",
    "headless": "tsx tools/headless.ts",
    "verify": "npm run typecheck && npm run lint && npm run check:boundaries && npm run check:assets && npm run check:content && npm run test",
    "build:bench": "npm run typecheck && vite build --mode bench",
    "worldgen": "tsx tools/worldgen-preview.ts",
    "check:content": "tsx tools/check-content.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
